rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Church members can be registered and looked up across devices
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Church contributions & dues records
    match /contributions/{contribId} {
      allow read, write: if true;
    }

    // Church branches configuration
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Church profile settings & branding
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
